# ==============================================================================
# FinGent Backend Environment Configuration
# ==============================================================================

# Option 1: Local Docker PostgreSQL (Port 5433 to prevent conflict with local 5432)
DATABASE_URL=postgresql://fingent_admin:fingent_password123@localhost:5433/fingent_db

# Option 2: Supabase Cloud PostgreSQL (Uncomment and replace with your Supabase credentials)
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Database Connection Pool Settings
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=15

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Zilliz Cloud / Milvus Vector Database Settings
MILVUS_URI=https://in03-your-cluster-id.serverless.gcp-us-west1.cloud.zilliz.com
MILVUS_TOKEN=your_username:your_password_or_api_key
